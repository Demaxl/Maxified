# Postgres connection string (Neon, Supabase, Render, or local Postgres).
# Leave empty for local development: submissions fall back to on-disk Nitro storage.
DATABASE_URL=

# Public site URL, used for canonical and Open Graph tags.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Footer links and contact address. Leave empty until the real accounts exist —
# empty values are hidden from the public UI rather than linking nowhere.
# A contact address is required before launch (the privacy policy needs it).
NUXT_PUBLIC_INSTAGRAM_URL=
NUXT_PUBLIC_TIKTOK_URL=
NUXT_PUBLIC_TWITTER_URL=
NUXT_PUBLIC_CONTACT_EMAIL=

# Plausible domain. Leave empty to skip loading any analytics script.
NUXT_PUBLIC_ANALYTICS_ID=

# Email marketing service, wired up in server/utils/email.ts. Leave empty until needed.
# Supported: resend. For Resend, use a Full access API key and a segment ID
# (Audience → Segments → ⋯ → Copy Segment ID). Use a test segment locally.
NUXT_EMAIL_PROVIDER=
NUXT_EMAIL_API_KEY=
NUXT_EMAIL_AUDIENCE_ID=
